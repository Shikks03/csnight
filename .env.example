# Copy this file to .env.local and fill in real values before running the project.

# Supabase project URL — find in Project Settings → API → Project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — find in Project Settings → API → service_role (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared password that CS Night officers use to log into the seat panel
# Use a strong password: min 12 chars, mix of letters, numbers, and symbols
ADMIN_PASSWORD=your-secure-admin-password-here

# Unguessable URL segment — seat panel lives at /staff/<slug>
# Use a random string: e.g. run  openssl rand -hex 16  to generate one
ADMIN_PATH_SLUG=your-unguessable-slug-here
