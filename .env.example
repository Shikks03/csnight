# Supabase project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared password that CS Night officers use to log into the seat panel
ADMIN_PASSWORD=your-secure-admin-password-here

# Unguessable URL segment — seat panel is served at /staff/<slug>
ADMIN_PATH_SLUG=your-unguessable-slug-here
